From: NixOS Orange Pi Zero 2W configuration
Subject: mmc: pwrseq_simple: Fall back to reset GPIO on ENOENT

An optional reset controller can return -ENOENT when a node supplies one
reset-gpios entry but no resets property. Treat that as absence so the
existing GPIO fallback can drive the radio reset line.

---
 drivers/mmc/core/pwrseq_simple.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/mmc/core/pwrseq_simple.c b/drivers/mmc/core/pwrseq_simple.c
--- a/drivers/mmc/core/pwrseq_simple.c
+++ b/drivers/mmc/core/pwrseq_simple.c
@@ -139,8 +139,11 @@ static int mmc_pwrseq_simple_probe(struct platform_device *pdev)
 	if (ngpio == 1) {
 		pwrseq->reset_ctrl = devm_reset_control_get_optional_shared(dev, NULL);
-		if (IS_ERR(pwrseq->reset_ctrl))
+		if (IS_ERR(pwrseq->reset_ctrl) &&
+		    PTR_ERR(pwrseq->reset_ctrl) != -ENOENT)
 			return dev_err_probe(dev, PTR_ERR(pwrseq->reset_ctrl),
 					     "reset control not ready\n");
+		if (IS_ERR(pwrseq->reset_ctrl))
+			pwrseq->reset_ctrl = NULL;
 	}
 
 	/*
